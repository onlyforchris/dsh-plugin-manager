{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Plugin Registry",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "plugin": {
      "type": "object",
      "required": [
        "id", "name", "packageName", "summary", "category", "repository",
        "installSpec", "version", "dshCompatibility", "verificationStatus",
        "verifiedWithDsh", "verifiedAt", "maintainer", "license",
        "recommendation", "permissions", "firstUse", "launch"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 214 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "installSpec": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1, "maxLength": 60 },
        "dshCompatibility": { "type": "string", "minLength": 1, "maxLength": 100 },
        "verificationStatus": { "enum": ["verified", "community", "experimental"] },
        "verifiedWithDsh": { "type": ["string", "null"] },
        "verifiedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "maintainer": { "type": "string", "minLength": 1, "maxLength": 100 },
        "license": { "type": "string", "minLength": 1, "maxLength": 60 },
        "recommendation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "permissions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "firstUse": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "launch": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "label", "target"],
              "properties": {
                "kind": { "enum": ["settings", "copy-prompt"] },
                "label": { "type": "string", "minLength": 1, "maxLength": 60 },
                "target": { "type": "string", "minLength": 1, "maxLength": 500 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
