    {
      "id": "omdsh-dsh-genui",
      "name": "GenUI 交互式回答",
      "packageName": "@omdsh-dev/dsh-genui",
      "summary": "把模型输出的 dsh-ui 白名单描述渲染成卡片、表格、图表、表单和交互面板。",
      "category": "交互",
      "repository": "https://github.com/omdsh-dev/dsh-genui",
      "installSpec": "https://github.com/omdsh-dev/dsh-genui#dab48fae600edb97859591ff6a25feb363d10721",
      "version": "0.8.7",
      "dshCompatibility": "0.1.0-rc.6",
      "verificationStatus": "experimental",
      "verifiedWithDsh": "0.1.0-rc.6",
      "verifiedAt": "2026-08-18",
      "maintainer": "omdsh-dev",
      "license": "MIT",
      "recommendation": "交互体验明显，但当前只能从 Git commit 安装，且仓库声明的 pnpm 范围与本次 DSH 环境不同，先按实验插件使用。",
      "permissions": [
        "在回答区域渲染白名单交互组件",
        "将用户触发的组件动作发送回当前会话",
        "按需加载 Mermaid 和 Three.js 本地资源"
      ]
    },
    {
      "id": "linxin-dsh-web-ui-all",
      "name": "Web UI 全家桶",
      "packageName": "@linxin666/dsh-web-ui-all",
      "summary": "一次安装任务看板、Git 图、皮肤、宠物、SSH、远程控制、运行统计等一组 Web UI 插件。",
      "category": "界面",
      "repository": "https://github.com/zhu1090093659/dsh-web-ui",
      "installSpec": "@linxin666/dsh-web-ui-all@0.1.20",
      "version": "0.1.20",
      "dshCompatibility": "0.1.0-rc.6",
      "verificationStatus": "experimental",
      "verifiedWithDsh": "0.1.0-rc.6",
      "verifiedAt": "2026-08-18",
      "maintainer": "zhu1090093659",
      "license": "Apache-2.0",
      "recommendation": "功能丰富但影响面大；本次页面和接口加载通过，SSH/远程功能依赖的原生构建脚本未执行，建议按需安装子插件。",
      "permissions": [
        "扩展 DSH Web 侧边栏、设置页和会话界面",
        "可选 SSH 与远程访问功能会读取相关配置并监听本地服务",
        "部分功能可能启动外部进程或访问网络"
