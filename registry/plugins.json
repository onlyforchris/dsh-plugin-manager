    {
      "id": "anionex-dsh-vision-toolkit",
      "name": "视觉工具箱",
      "packageName": "@anionex/dsh-vision-toolkit",
      "summary": "让文本模型在 DSH 中完成截图理解、OCR、元素定位、裁剪、SVG 描摹和像素对比。",
      "category": "视觉",
      "repository": "https://github.com/Anionex/dsh-vision-toolkit",
      "installSpec": "@anionex/dsh-vision-toolkit@0.1.31",
      "version": "0.1.31",
      "dshCompatibility": "0.1.0-rc.6",
      "verificationStatus": "verified",
      "verifiedWithDsh": "0.1.0-rc.6",
      "verifiedAt": "2026-08-18",
      "maintainer": "Anionex",
      "license": "MIT",
      "recommendation": "适合需要分析截图、还原界面或处理视觉素材的用户；安装后在设置中可看到独立的视觉工具入口。",
      "permissions": [
        "读取会话工作区中的图像文件",
        "使用内置视觉服务时访问外部网络",
        "首次使用时可能下载隔离 Python 运行时"
      ]
    },
    {
      "id": "omdsh-dsh-at-file",
      "name": "@ 文件提及",
      "packageName": "dsh-at-file",
      "summary": "在输入框键入 @ 搜索当前工作区，并插入安全的文件或目录路径引用。",
      "category": "效率",
      "repository": "https://github.com/omdsh-dev/dsh-at-file",
      "installSpec": "https://github.com/omdsh-dev/dsh-at-file#v0.6.3",
      "version": "0.6.3",
      "dshCompatibility": "0.1.0-rc.6",
      "verificationStatus": "verified",
      "verifiedWithDsh": "0.1.0-rc.6",
      "verifiedAt": "2026-08-18",
      "maintainer": "omdsh-dev",
      "license": "MIT",
      "recommendation": "高频、低侵入的基础能力；只传递工作区相对路径，不会在提交时自动读取文件内容。",
      "permissions": [
