    {
      "id": "awesome-dsh-find-plugin",
      "name": "插件搜索",
      "packageName": "dsh-find-plugin",
      "summary": "让 Agent 按需求搜索带 dsh-plugin 主题的 GitHub 仓库，并返回候选和安装命令。",
      "category": "发现",
      "repository": "https://github.com/awesome-dsh-plugin/dsh-find-plugin",
      "installSpec": "dsh-find-plugin@0.3.6",
